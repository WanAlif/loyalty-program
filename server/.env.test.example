# Points at a SEPARATE database from your dev DB so tests never touch
# real/dev data. Uses the same local Postgres container, just a
# different database name.
DATABASE_URL="postgresql://postgres:localdevpass@localhost:5432/loyalty_test"

JWT_SECRET="test-secret-not-for-production"
JWT_EXPIRES_IN="30m"

PORT=5001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="test"

COOKIE_NAME="loyalty_token"
